    "生成采用确定性规则：按训练天数选择分化，按器械筛选动作，按目标决定组数、次数与休息；多周计划每周按比例加重。这里的条件也会作为每日自动发布训练的偏好。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Generation follows deterministic rules: the split is chosen by training days, exercises are filtered by equipment, and sets, reps and rest are set by your goal; multi-week plans add load proportionally each week. These settings also serve as preferences for the automatically published daily workout."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "生成采用确定性规则：按训练天数选择分化，按器械筛选动作，按目标决定组数、次数与休息；多周计划每周按比例加重。这里的条件也会作为每日自动发布训练的偏好。"
          }
        }
      }
    },
    "生日": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Birthday"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "生日"
          }
        }
      }
    },
