{
  "sourceLanguage": "zh-Hans",
  "strings": {
    "## 用户": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "## Profile"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "## 用户"
          }
        }
      }
    },
    "%@，%lld 岁，身高 %@ cm，体重 %@ kg，活动水平 %@，饮食目标 %@。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@, %lld years old, %@ cm tall, %@ kg, activity level %@, nutrition goal %@."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@，%lld 岁，身高 %@ cm，体重 %@ kg，活动水平 %@，饮食目标 %@。"
          }
        }
      }
    },
    "## 力量段位": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "## Strength rank"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "## 力量段位"
          }
        }
      }
    },
    "总体评分 GSR %lld，当前为 %@ 段位。评分 1–1000，按 e1RM/体重与性别曲线换算。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Global Strength Rating %lld, current tier %@. Scores range from 1 to 1000 and account for e1RM, bodyweight, and sex."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "总体评分 GSR %lld，当前为 %@ 段位。评分 1–1000，按 e1RM/体重与性别曲线换算。"
          }
        }
      }
    },
    "肌群评分：%@。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Muscle group scores: %@."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "肌群评分：%@。"
          }
        }
      }
    },
    "动作最佳：%@": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Best lifts: %@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "动作最佳：%@"
          }
        }
      }
    },
    "## 最近 %lld 天力量训练": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "## Strength training over the last %lld days"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "## 最近 %lld 天力量训练"
          }
        }
      }
    },
    "共 %lld 次，总训练量 %@ kg，%lld 组。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld sessions, %@ kg total training volume, %lld sets."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "共 %lld 次，总训练量 %@ kg，%lld 组。"
          }
        }
      }
    },
    "本窗口实际训练记录日期范围：%@–%@。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Dates with strength training records in this window: %@–%@."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "本窗口实际训练记录日期范围：%@–%@。"
          }
        }
      }
    },
    "各肌群组数：%@": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sets by muscle group: %@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "各肌群组数：%@"
          }
        }
      }
    },
    "%@ · %lld 组": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ · %lld sets"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ · %lld 组"
          }
        }
      }
    },
    " · 最重 %@ kg × %lld": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": " · heaviest %@ kg × %lld"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": " · 最重 %@ kg × %lld"
          }
        }
      }
    },
    "## 最近 %lld 天有氧": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "## Cardio over the last %lld days"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "## 最近 %lld 天有氧"
          }
        }
      }
    },
    "无记录。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No records."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无记录。"
          }
        }
      }
    },
    "共 %lld 次，%@ 分钟，%@ km，消耗约 %@ kcal。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld sessions, %@ minutes, %@ km, about %@ kcal burned."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "共 %lld 次，%@ 分钟，%@ km，消耗约 %@ kcal。"
          }
        }
      }
    },
    "%@ · %lld 次": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ · %lld sessions"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ · %lld 次"
          }
        }
      }
    },
    "## 身体数据": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "## Body measurements"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "## 身体数据"
          }
        }
      }
    },
    "%@：%@ %@ %@ → %@ %@ %@（共 %lld 次记录）。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@: %@ %@ %@ → %@ %@ %@ (%lld entries)."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@：%@ %@ %@ → %@ %@ %@（共 %lld 次记录）。"
          }
        }
      }
    },
    "最新身体测量：%@": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Latest body measurements: %@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "最新身体测量：%@"
          }
        }
      }
    },
    "## 最近 7 天饮食": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "## Nutrition over the last 7 days"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "## 最近 7 天饮食"
          }
        }
      }
    },
    "有餐食记录的天数：%lld/7；共 %lld 条。没有全天记录完整性的标记，无法判断是否达到每日摄入目标。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Meals logged on %lld of 7 days, %lld entries total. Full-day coverage is unknown, so these entries cannot establish whether daily intake goals were met."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "有餐食记录的天数：%lld/7；共 %lld 条。没有全天记录完整性的标记，无法判断是否达到每日摄入目标。"
          }
        }
      }
    },
    "有效记录太少，暂不估算摄入。请记录几天完整饮食后再评估。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "There are too few entries to estimate intake. Log a few complete days before reassessing."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "有效记录太少，暂不估算摄入。请记录几天完整饮食后再评估。"
          }
        }
      }
    },
    "- %@ %@：%@（仅一条记录）。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "- %@ %@: %@ (one entry)."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "- %@ %@：%@（仅一条记录）。"
