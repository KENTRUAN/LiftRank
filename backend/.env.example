GOOGLE_CLOUD_PROJECT=demo-liftrank
FIREBASE_DATABASE_URL=https://demo-liftrank-default-rtdb.firebaseio.com
FIREBASE_DATABASE_EMULATOR_HOST=127.0.0.1:9000
FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
PORT=8080

# Cloud deployment uses project liftrank-514018. Do not set emulator variables there.
# Store these in Secret Manager for Cloud Run, not in Git.
GOOGLE_PLACES_API_KEY=
TINKER_API_KEY=
# Workout trainer only. Set to the evaluated tinker://.../sampler_weights/... checkpoint.
TINKER_TRAINER_MODEL=thinkingmachines/Inkling
TINKER_REQUIRE_FINE_TUNED=false
# Generic AI: add your own Gemini Developer API key later. Never reuse the Tinker key.
GEMINI_API_KEY=
GENERAL_AI_MODEL=gemini-2.5-flash
AVATAR_MODEL=gemini-3.1-flash-image
AVATAR_GLOBAL_LIMIT=30
COMPANION_GLOBAL_LIMIT=300
GENERAL_AI_GLOBAL_LIMIT=300
SEARCH_GLOBAL_LIMIT=2000
